{
  "name": "koinous",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.10.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env --experimental-strip-types src/server.ts",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test && npm run test:guest",
    "test:guest": "python3 -B tests/grok-build-guest.test.py && python3 -B tests/grok-egress.test.py",
    "smoke:grok": "node --env-file=.env --experimental-strip-types scripts/grok-smoke.ts",
    "start:secure": "node --env-file-if-exists=.env --experimental-strip-types src/secure-server.ts",
    "demo": "node --experimental-strip-types scripts/demo.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.316",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@openai/codex-sdk": "0.166.0",
    "jose": "6.2.14"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "typescript": "7.0.2"
  }
}
